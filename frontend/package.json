{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run copy:embedpdf && vite dev",
		"build": "npm run copy:embedpdf && vite build && npm run stamp:sw",
		"preview": "vite preview",
		"copy:embedpdf": "node scripts/copy-embedpdf.mjs",
		"stamp:sw": "node scripts/stamp-sw-version.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/turndown": "^5.0.6",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@embedpdf/plugin-i18n": "^2.15.0",
		"@embedpdf/svelte-pdf-viewer": "^2.15.0",
		"@tiptap/core": "^3.30.5",
		"@tiptap/pm": "^3.30.5",
		"@tiptap/starter-kit": "^3.30.5",
		"boxicons": "^2.1.4",
		"clsx": "^2.1.1",
		"pdfjs-dist": "^6.1.200",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"turndown": "^7.2.4"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
